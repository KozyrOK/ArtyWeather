APP_NAME=ArtyWeather
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=artyweather
DB_USERNAME=sail
DB_PASSWORD=password
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=arty_weather_cache

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=arty_weather_database_

QUEUE_CONNECTION=redis

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:8000,127.0.0.1:5173,::1
SANCTUM_TOKEN_PREFIX=arty_weather_

MAIL_MAILER=log
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"

########################################
# AI Configuration
########################################

AI_PROVIDER=ollama
AI_MODEL=qwen3:8b
OLLAMA_URL=http://host.docker.internal:11434

########################################
# Weather Presentation
########################################

WEATHER_PRESENTATION_QUEUE=weather-presentations
WEATHER_PRESENTATION_CACHE_TTL=900